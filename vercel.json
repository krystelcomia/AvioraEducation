{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|uploads/|css/|js/|assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
