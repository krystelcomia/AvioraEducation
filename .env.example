# ==========================================
# AVIORA EDUCATION - ENVIRONMENT CONFIGURATION
# ==========================================
PORT=3000
JWT_SECRET=aviora-education-secret-key-2026-luxury-edtech

# ------------------------------------------
# GOOGLE OAUTH 2.0 (Free via Google Cloud Console)
# 1. Visit https://console.cloud.google.com/
# 2. APIs & Services > Credentials > Create OAuth Client ID (Web Application)
# 3. Add Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
# ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ------------------------------------------
# FACEBOOK LOGIN API (Free via Meta for Developers)
# 1. Visit https://developers.facebook.com/
# 2. Create App > Add Facebook Login Product
# 3. Add Valid OAuth Redirect URI: http://localhost:3000/api/auth/facebook/callback
# ------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# ------------------------------------------
# APPLICATION PUBLIC URL (Used in email links & logos)
# For deployed production (Vercel), set to https://avioraeducation.vercel.app
# For local development, set to http://localhost:3000
# ------------------------------------------
APP_URL=https://avioraeducation.vercel.app

# ------------------------------------------
# TRANSACTIONAL EMAIL & GMAIL SMTP (Server-Side Only — Never Exposed to Frontend)
# Required for Password Reset Verification Codes & Website Gmail Notifications:
# Option A (Recommended for Gmail): Gmail SMTP with a 16-character Google App Password:
#   GMAIL_USER=youraccount@gmail.com
#   GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Option B: Custom SMTP Server (SendGrid, Brevo, Zoho, Postmark, Hostinger, etc.):
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey-or-username
#   SMTP_PASS=smtp-password
#   EMAIL_FROM="Aviora Education <no-reply@yourdomain.com>"
# Option C: Resend, Brevo, SendGrid, or Google Apps Script HTTP API:
#   RESEND_API_KEY=
#   RESEND_FROM=
#   BREVO_API_KEY=
#   BREVO_SENDER_EMAIL=
#   SENDGRID_API_KEY=
#   SENDGRID_FROM=
#   GMAIL_WEBHOOK_URL=
# Option D: EmailJS Server REST API (Requires Private Key kept strictly server-side):
#   EMAILJS_SERVICE_ID=
#   EMAILJS_TEMPLATE_ID=
#   EMAILJS_RESET_TEMPLATE_ID=
#   EMAILJS_NOTIFICATION_TEMPLATE_ID=
#   EMAILJS_PUBLIC_KEY=
#   EMAILJS_PRIVATE_KEY=
# ------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_FROM=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM=
GMAIL_WEBHOOK_URL=

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_NOTIFICATION_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
