# ==========================================
# AVIORA EDUCATION - ENVIRONMENT CONFIGURATION
# ==========================================
PORT=3000
JWT_SECRET=aviora-education-secret-key-2026-luxury-edtech

# ------------------------------------------
# GOOGLE OAUTH 2.0 (Free via Google Cloud Console)
# 1. Visit https://console.cloud.google.com/
# 2. APIs & Services > Credentials > Create OAuth Client ID (Web Application)
# 3. Add Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
# ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ------------------------------------------
# FACEBOOK LOGIN API (Free via Meta for Developers)
# 1. Visit https://developers.facebook.com/
# 2. Create App > Add Facebook Login Product
# 3. Add Valid OAuth Redirect URI: http://localhost:3000/api/auth/facebook/callback
# ------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
